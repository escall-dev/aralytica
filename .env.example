# ==========================================
# ARALytica Environment Variables (Template)
# ==========================================
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION SECRETS.
# Copy this file to .env.local for local overrides.

# App Environment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend Transactional Email (Phase 4)
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender identity configured in Resend (e.g., ARALytica Inquiries <noreply@aralytica.com>)
# If domain verification is pending, Resend sandbox uses "onboarding@resend.dev"
CONTACT_FROM_EMAIL=

# Institutional recipient for contact form inquiries
CONTACT_TO_EMAIL=aralytica@gmail.com

# Sanity CMS (Phase 5)
# Public Sanity project configuration (accessible in browser and server)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only Sanity configuration (never exposed to browser)
# Optional read token for fetching preview drafts or private datasets
SANITY_API_READ_TOKEN=

# Optional authenticated write token (for migrations/admin scripts only; never in client)
SANITY_API_WRITE_TOKEN=

# Optional webhook secret for on-demand ISR revalidation
SANITY_REVALIDATE_SECRET=

# Analytics (Future Phases)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
